# Copy this file to `.env` and adjust. `.env` is gitignored; this template is committed.
# Every variable the app reads must appear here so a new machine knows what to set.

ENVIRONMENT=local
DEBUG=true

# Async SQLAlchemy URL. Host `localhost` when running the app on your machine against
# the docker-compose database; host `db` when the app itself runs inside compose.
DATABASE_URL=postgresql+asyncpg://sadyba:sadyba@localhost:5432/sadyba
