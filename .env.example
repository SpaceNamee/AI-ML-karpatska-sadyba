# Copy this file to `.env` and adjust. `.env` is gitignored; this template is committed.
# Every variable the app reads must appear here so a new machine knows what to set.

ENVIRONMENT=local
DEBUG=true

# Async SQLAlchemy URL.
#   - from your machine against the compose DB:  host localhost, port 5433
#   - from inside compose (the api container):   host db, port 5432
# Port 5433 (not 5432) avoids clashing with a native Postgres install.
DATABASE_URL=postgresql+asyncpg://sadyba:sadyba@localhost:5433/sadyba

# Generate your own per environment: python -c "import secrets; print(secrets.token_hex(32))"
# No default in code, no value here on purpose — never inherit a working secret
# by copying this file.
JWT_SECRET_KEY=

# Optional. Set it and run `uv run python -m app.db.seed_admin` to create a
# first admin account. Leave unset (as here) so nobody gets a default password.
ADMIN_SEED_PASSWORD=
