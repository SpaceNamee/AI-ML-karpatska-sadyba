# Copy this file to `.env` and adjust. `.env` is gitignored; this template is committed.
# Every variable the app reads must appear here so a new machine knows what to set.

ENVIRONMENT=local
DEBUG=true

# Async SQLAlchemy URL.
#   - from your machine against the compose DB:  host localhost, port 5433
#   - from inside compose (the api container):   host db, port 5432
# Port 5433 (not 5432) avoids clashing with a native Postgres install.
DATABASE_URL=postgresql+asyncpg://sadyba:sadyba@localhost:5433/sadyba

# Same host/port split as DATABASE_URL: localhost from your machine, `redis`
# from inside compose.
REDIS_URL=redis://localhost:6379/0

# Generate your own per environment: python -c "import secrets; print(secrets.token_hex(32))"
# No default in code, no value here on purpose — never inherit a working secret
# by copying this file.
JWT_SECRET_KEY=

# Optional. Set it and run `uv run python -m app.db.seed_admin` to create a
# first admin account. Leave unset (as here) so nobody gets a default password.
ADMIN_SEED_PASSWORD=

# Optional — POST /ask (RAG answers) 503s with a clear message if unset;
# everything else (catalog, availability, upload, POST /query) works without it.
# Any OpenAI-compatible provider works by changing all three together:
#   Gemini free tier (default below) — get a key at https://aistudio.google.com/apikey
#   DeepSeek   — LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
#   OpenAI     — LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini (or current mini model)
# Verify current model names/prices on the provider's site before relying on them.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# $ per 1,000,000 tokens, from your provider's pricing page — used only to
# compute llm_calls.cost_usd; left at 0 rather than a guess that could be stale.
LLM_PRICE_PER_MILLION_INPUT_TOKENS=0
LLM_PRICE_PER_MILLION_OUTPUT_TOKENS=0
