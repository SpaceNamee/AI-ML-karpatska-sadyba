# IDE / editors
.idea/
.vscode/

# Project docs (local source of truth, not versioned here)
docs

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local config
.env
.env.*
!.env.example

# Uploaded knowledge-base files (local dev; a Docker volume in compose)
data/

# HF model cache. Should only ever live in the `hf_cache` Docker volume or the
# host's own ~/.cache/huggingface — this entry guards against a bind-mount
# misconfiguration leaking a container's HF_HOME into the project root again.
.cache/
